# Copia este archivo como .env y configura tu propio bot.
# Nunca publiques el token ni compartas el archivo .env.
DISCORD_TOKEN=TU_TOKEN_AQUI
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=5000
# Opcionales: deja 0 si no quieres configurar propietario o canal de registros.
SENTINEL_OWNER_ID=0
SENTINEL_LOG_CHANNEL_ID=0
